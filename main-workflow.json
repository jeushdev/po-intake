        "options": {
          "queryReplacement": "={{ JSON.stringify($json.body) }}\n{{ $json.headers[\"x-forwarded-for\"] || \"unknown\" }}\n{{$json.body.email.toLowerCase().trim() }}\n{{ $json.body.full_name.toLowerCase().trim() }}\n{{ $json.body.request_type.toLowerCase().trim() }}"
